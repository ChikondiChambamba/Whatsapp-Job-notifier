{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "rootDir": "..",
    "outDir": "../desktop-dist",
    "types": ["node"]
  },
  "include": ["*.ts"]
}
