{
  "name": "whatsapp-job-notifier",
  "version": "0.1.0",
  "productName": "WhatsApp Alerts",
  "description": "Get alerts when WhatsApp groups and channels post what you are looking for.",
  "main": "desktop-dist/desktop/main.js",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "web:dev": "vite --config web/vite.config.ts",
    "list:chats": "tsx src/tools/listChats.ts",
    "test:email": "tsx src/tools/testEmail.ts",
    "typecheck": "tsc --noEmit && tsc -p web --noEmit && tsc -p desktop --noEmit",
    "lint": "eslint src web/src desktop",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json && vite build --config web/vite.config.ts && tsc -p desktop",
    "desktop": "npm run build && electron-rebuild -f -o better-sqlite3 && electron . ; npm rebuild better-sqlite3",
    "dist:win": "npm run build && electron-builder --win && npm rebuild better-sqlite3",
    "dist:mac": "npm run build && electron-builder --mac && npm rebuild better-sqlite3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.11.0",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "nodemailer": "^9.0.6",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.0",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.5",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "eslint": "^10.9.1",
    "prettier": "^3.9.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^7.3.8",
    "vitest": "^4.1.11"
  },
  "build": {
    "appId": "com.whatsappalerts.app",
    "productName": "WhatsApp Alerts",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "web-dist/**/*",
      "desktop-dist/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "runAfterFinish": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "icon": "assets/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    }
  }
}
