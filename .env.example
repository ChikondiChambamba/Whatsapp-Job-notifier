# Technical settings. Alert email, watched groups/channels and match rules
# are stored in the app database (see README).
APP_DATA_DIR=
LOG_LEVEL=info
DASHBOARD_PORT=4000
PROCESS_HISTORY_MESSAGES=true
HEARTBEAT_INTERVAL_MS=30000
CATCHUP_MIN_GAP_MS=120000
CATCHUP_MAX_AGE_HOURS=72
CATCHUP_DIGEST_THRESHOLD=3
CATCHUP_SETTLE_MS=30000
OUTBOX_DRAIN_INTERVAL_MS=60000

# Legacy: imported once into the database on first start, then ignored.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_TO=
WATCHED_GROUP_JIDS=
WATCHED_CHANNEL_JIDS=
WATCHED_CHANNEL_LINKS=
MATCH_THRESHOLD=4
